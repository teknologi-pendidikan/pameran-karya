{
    "name": "pamerankarya-monorepo",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@10.0.0",
    "scripts": {
        "dev:frontend": "pnpm --filter pamerankarya dev",
        "dev:backoffice": "pnpm --filter backoffice dev",
        "build:frontend": "pnpm --filter pamerankarya build",
        "build:backoffice": "pnpm --filter backoffice build",
        "dev:all": "pnpm --filter '*' dev",
        "build:all": "pnpm --filter '*' build",
        "lint:all": "pnpm --filter '*' lint",
        "clean:all": "pnpm --filter '*' clean",
        "install:all": "pnpm install",
        "dev": "pnpm dev:frontend"
    },
    "workspaces": [
        "apps/*"
    ],
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.0.0"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=10.0.0"
    }
}
