{
    "name": "pamerankarya",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@10.0.0",
    "scripts": {
        "dev:exhibition": "pnpm --filter web-exhibition dev",
        "dev:backoffice": "pnpm --filter web-backoffice dev",
        "build:exhibition": "pnpm --filter web-exhibition build",
        "build:backoffice": "pnpm --filter web-backoffice build",
        "clean:exhibition": "pnpm --filter web-exhibition clean",
        "clean:backoffice": "pnpm --filter web-backoffice clean",
        "dev:all": "pnpm -r dev",
        "build:all": "pnpm -r build",
        "lint:all": "pnpm -r lint",
        "lint:all:fix": "pnpm -r lint:fix",
        "clean:all": "pnpm -r clean",
        "install:all": "pnpm install",
        "dev": "pnpm dev:exhibition",
        "serve:exhibition": "serve apps/web-exhibition/out"
    },
    "workspaces": [
        "apps/*"
    ],
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.0.0"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=10.0.0"
    },
    "dependencies": {
        "serve": "^14.2.5"
    }
}
